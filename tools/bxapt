#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
package_id=io.taowen.bx
serial="${ANDROID_SERIAL:-}"
dns_servers="${BIONICX_DNS_SERVERS:-}"

usage() {
    echo "usage: tools/bxapt [--serial SERIAL] [--dns ADDRESSES] COMMAND [ARG ...]" >&2
    echo "commands: update, install, remove, autoremove, set, deb, recover, fixup, normalize, apt, dpkg, query, run" >&2
    exit "${1:-2}"
}

while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --serial) [[ $# -ge 2 ]] || usage; serial="$2"; shift 2 ;;
        --dns) [[ $# -ge 2 ]] || usage; dns_servers="$2"; shift 2 ;;
        --help) usage 0 ;;
        *) usage ;;
    esac
done
[[ $# -ge 1 ]] || usage
command_name="$1"
shift

adb_command=("${ADB:-adb}")
[[ -z "$serial" ]] || adb_command+=(-s "$serial")
root="/data/user/0/$package_id/files/rootfs"
files="/data/user/0/$package_id/files"
run_dir="$files/run/bxapt"
unpack_manifest="$run_dir/unpacked-paths.txt"
package_snapshot="$run_dir/installed-packages-before.txt"
requested_state="$run_dir/requested-packages.txt"
perl_libs="$root/etc/perl:$root/usr/share/perl5:$root/usr/lib/aarch64-linux-gnu/perl-base:$root/usr/lib/aarch64-linux-gnu/perl/5.40:$root/usr/share/perl/5.40"

run_as() {
    local command="run-as $(shell_quote "$package_id")"
    local argument
    for argument in "$@"; do
        command+=" $(shell_quote "$argument")"
    done
    "${adb_command[@]}" shell "$command"
}

shell_quote() {
    local value="${1//\'/\'\\\'\'}"
    printf "'%s'" "$value"
}

discover_dns() {
    [[ -n "$dns_servers" ]] && return
    dns_servers="$("${adb_command[@]}" shell dumpsys connectivity 2>/dev/null |
        sed -n 's/.*DnsAddresses: \[[^]]*\/\([0-9][0-9.]*\).*/\1/p' |
        head -n 1)"
}

upload_private() {
    local source="$1"
    local destination="$2"
    local temporary="/data/local/tmp/bxapt-$$-${source##*/}"
    "${adb_command[@]}" push "$source" "$temporary" >/dev/null
    run_as cp "$temporary" "$destination"
    "${adb_command[@]}" shell rm "$temporary"
}

deb_package_name() {
    local archive="$1"
    local member
    member="$(ar t "$archive" | awk '/^control\.tar/{ print; exit }')"
    [[ -n "$member" ]] || {
        echo "missing control archive in $archive" >&2
        return 1
    }
    local decompressor=()
    case "$member" in
        *.xz) decompressor=(xz -dc) ;;
        *.zst) decompressor=(zstd -dc) ;;
        *.gz) decompressor=(gzip -dc) ;;
        *.bz2) decompressor=(bzip2 -dc) ;;
        *.tar) decompressor=(cat) ;;
        *) echo "unsupported control archive: $member" >&2; return 1 ;;
    esac
    ar p "$archive" "$member" | "${decompressor[@]}" | \
        tar -xOf - ./control | sed -n 's/^Package: //p' | head -n 1
}

prepare_state() {
    run_as test -x "$files/bin/bionicx-exec"
    run_as test -x "$root/usr/bin/apt-get"
    run_as test -r "$files/lib/libbionicx-runtime.so"
    run_as mkdir -p \
        "$run_dir/apt.conf.d" "$files/homes/bxapt" \
        "$run_dir/incoming" "$run_dir/run" \
        "$root/var/lib/apt/lists/partial" \
        "$root/var/cache/apt/archives/partial" \
        "$root/var/log/apt"

    mkdir -p "$repo_dir/build"
    sed -e "s|@ROOT@|$root|g" -e "s|@FILES@|$files|g" \
        "$repo_dir/tools/bxapt.conf.in" > "$repo_dir/build/bxapt.conf"
    upload_private "$repo_dir/build/bxapt.conf" "$run_dir/apt.conf"
    upload_private "$repo_dir/tools/rootfs-elf-fixup.sh" \
        "$run_dir/rootfs-elf-fixup.sh"
    upload_private "$repo_dir/tools/bxapt-unpack.sh" \
        "$run_dir/bxapt-unpack.sh"
    upload_private "$repo_dir/tools/bxapt-ldconfig.sh" \
        "$run_dir/bxapt-ldconfig.sh"
    # The installed APK may extract an older libbionicx-runtime.so on launch.
    # Refresh it from the tree that matches this bxapt so groupadd/open hooks
    # stay in place for maintainer scripts.
    runtime_so="$repo_dir/android/app/src/main/assets/bionicx/lib/libbionicx-runtime.so"
    if [[ -f "$runtime_so" ]]; then
        upload_private "$runtime_so" "$files/lib/libbionicx-runtime.so"
    fi
    run_as cp "$root/etc/apt/sources.list.d/debian.sources" \
        "$run_dir/sources.sources"
}

requested_packages=()
case "$command_name" in
    update) arguments=(update) ;;
    install)
        [[ $# -ge 1 ]] || usage
        install_arguments=()
        for argument in "$@"; do
            if [[ "$argument" == --reinstall ]]; then
                install_arguments+=("$argument")
                continue
            fi
            if [[ ! "$argument" =~ ^[a-z0-9][a-z0-9+.-]*(:arm64)?(=[^[:space:]]+)?$ ]]; then
                echo "invalid install argument: $argument" >&2
                exit 2
            fi
            install_arguments+=("$argument")
            requested="${argument%%=*}"
            requested_packages+=("${requested%:arm64}")
        done
        [[ ${#requested_packages[@]} -gt 0 ]] || usage
        arguments=(install -y --no-install-recommends "${install_arguments[@]}")
        ;;
    remove)
        [[ $# -ge 1 ]] || usage
        arguments=(remove -y "$@")
        ;;
    autoremove)
        [[ $# -eq 0 ]] || usage
        arguments=(autoremove -y)
        ;;
    set)
        [[ $# -eq 1 && -f "$1" ]] || usage
        packages=()
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%%#*}"
            read -r package extra <<< "$line"
            [[ -n "${package:-}" ]] || continue
            if [[ -n "${extra:-}" ||
                    ! "$package" =~ ^[a-z0-9][a-z0-9+.-]*(:arm64)?$ ]]; then
                echo "invalid package declaration: $line" >&2
                exit 2
            fi
            packages+=("$package")
        done < "$1"
        [[ ${#packages[@]} -gt 0 ]] || {
            echo "empty package set: $1" >&2
            exit 2
        }
        for package in "${packages[@]}"; do
            requested_packages+=("${package%:arm64}")
        done
        arguments=(install -y --no-install-recommends "${packages[@]}")
        ;;
    deb)
        [[ $# -eq 2 && -f "$1" && "$2" =~ ^[0-9a-fA-F]{64}$ ]] || usage
        host_deb="$(realpath "$1")"
        expected_sha256="${2,,}"
        actual_sha256="$(sha256sum "$host_deb" | cut -d' ' -f1)"
        if [[ "$actual_sha256" != "$expected_sha256" ]]; then
            echo "checksum mismatch for $host_deb" >&2
            echo "expected: $expected_sha256" >&2
            echo "actual:   $actual_sha256" >&2
            exit 1
        fi
        deb_package="$(deb_package_name "$host_deb")"
        if [[ ! "$deb_package" =~ ^[a-z0-9][a-z0-9+.-]*$ ]]; then
            echo "invalid Package field in $host_deb: $deb_package" >&2
            exit 1
        fi
        requested_packages+=("$deb_package")
        arguments=()
        ;;
    recover)
        [[ $# -eq 0 ]] || usage
        arguments=()
        ;;
    fixup) [[ $# -eq 0 ]] || usage; arguments=() ;;
    normalize)
        [[ $# -eq 1 && "$1" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || usage
        normalize_tree="$files/apps/$1"
        arguments=()
        ;;
    apt) arguments=("$@") ;;
    dpkg|query) arguments=("$@") ;;
    run)
        [[ $# -ge 1 ]] || usage
        if [[ "$1" == /* ]]; then
            binary="$root$1"
        else
            binary="$root/usr/bin/$1"
        fi
        shift
        arguments=("$@")
        ;;
    *) usage ;;
esac

discover_dns
prepare_state

environment=(
    "DPKG_DATADIR=$root/usr/share/dpkg"
    "DPKG_ROOT=$root"
    "LD_PRELOAD=$files/lib/libbionicx-runtime.so"
    "BIONICX_ROOTFS=$root"
    "BIONICX_TMPDIR=$run_dir"
    "BIONICX_REWRITE_ABSOLUTE_SYMLINKS=1"
    "BIONICX_DNS_SERVERS=$dns_servers"
    "BIONICX_UNPACK_MANIFEST=$unpack_manifest"
    "BIONICX_PACKAGE_SNAPSHOT=$package_snapshot"
    "BIONICX_REQUESTED_PACKAGES=$requested_state"
    "BIONICX_REMAINING_DEBS=$run_dir/remaining-debs.txt"
    "BIONICX_APT_CONFIG=$run_dir/apt.conf"
    "FONTCONFIG_PATH=$root/etc/fonts"
    "FONTCONFIG_FILE=fonts.conf"
    "FONTCONFIG_SYSROOT=$root"
    "SEQUOIA_CRYPTO_POLICY=$root/usr/share/apt/default-sequoia.config"
    "PERL5LIB=$perl_libs"
    "DEBIAN_FRONTEND=noninteractive"
    "DEBCONF_NONINTERACTIVE_SEEN=true"
    "PATH=$root/usr/sbin:$root/usr/bin:$root/sbin:$root/bin:/system/bin"
    "HOME=$files/homes/bxapt"
    "TMPDIR=$run_dir"
)

# dpkg intentionally runs maintainer scripts without a kernel chroot because
# the Android app UID cannot call chroot(2). Give apt/dpkg and their children
# the same logical uid/gid 0 contract that the runtime's virtual chroot would
# establish, while retaining the app's real kernel credentials. Generic
# `bxapt run` commands and application profiles must continue to observe the
# ordinary Android UID.
case "$command_name" in
    run|query) ;;
    *) environment+=("BIONICX_VIRTUAL_ROOT=1") ;;
esac

run_binary() {
    local command_arguments=("${arguments[@]}")
    if [[ "$binary" == "$root/usr/bin/apt-get" ]]; then
        command_arguments=(-c "$run_dir/apt.conf" "${command_arguments[@]}")
    fi
    local launcher=(
        "$files/bin/bionicx-exec"
        --cwd "$root"
    )
    local assignment
    for assignment in "${environment[@]}"; do
        launcher+=(--env "$assignment")
    done
    launcher+=(-- "$binary" "${command_arguments[@]}")
    run_as "${launcher[@]}"
}

ensure_ldconfig_wrapper() {
    local saved_binary="${binary:-}"
    local saved_arguments=("${arguments[@]}")
    binary="$root/bin/sh"
    arguments=("$run_dir/bxapt-ldconfig.sh" --install \
        "$run_dir/bxapt-ldconfig.sh")
    run_binary
    binary="$saved_binary"
    arguments=("${saved_arguments[@]}")
}

fixup_elf() {
    local tree="${1:-$root}"
    binary="$root/bin/sh"
    arguments=("$run_dir/rootfs-elf-fixup.sh" "$tree" "$root")
    run_binary
}

fixup_unpacked_elf() {
    binary="$root/bin/sh"
    arguments=("$run_dir/rootfs-elf-fixup.sh" --paths-from \
        "$unpack_manifest" "$root" "$root")
    run_binary
}

snapshot_package_state() {
    binary="$root/bin/sh"
    arguments=("$run_dir/bxapt-unpack.sh" --snapshot)
    run_binary
}

record_requested_packages() {
    binary="$root/bin/sh"
    arguments=("$run_dir/bxapt-unpack.sh" --record-requested \
        "${requested_packages[@]}")
    run_binary
}

reconcile_package_state() {
    binary="$root/bin/sh"
    arguments=("$run_dir/bxapt-unpack.sh" --reconcile \
        "${requested_packages[@]}")
    run_binary
}

clear_transaction_state() {
    run_as rm -f "$package_snapshot" "$requested_state" "$unpack_manifest" \
        "$run_dir/remaining-debs.txt" "$run_dir/remaining-debs.txt.next" \
        "$run_dir/remaining-debs.txt.count"
}

remaining_deb_count() {
    if run_as test -r "$run_dir/remaining-debs.txt.count"; then
        run_as cat "$run_dir/remaining-debs.txt.count" | tr -d '\r\n\t '
        return
    fi
    printf '0'
}

configure_unpacked() {
    local allow_fail="${1:-}"
    binary="$root/usr/bin/dpkg"
    arguments=(--force-not-root --force-script-chrootless \
        --root="$root" --admindir="$root/var/lib/dpkg" \
        --abort-after=10000 --configure -a)
    if [[ -n "$allow_fail" ]]; then
        run_binary || true
    else
        run_binary
    fi
}

mark_systemd_replacement() {
    local package
    for package in "${requested_packages[@]+"${requested_packages[@]}"}"; do
        case "$package" in
            systemd|systemd-sysv) environment+=("BIONICX_REPLACING_SYSTEMD=1"); return ;;
        esac
    done
    if [[ "$command_name" == recover ]]; then
        environment+=("BIONICX_REPLACING_SYSTEMD=1")
    fi
}

remove_standalone_systemd_if_replacing() {
    binary="$root/bin/sh"
    arguments=("$run_dir/bxapt-unpack.sh" --remove-conflicts)
    run_binary
}

# Unpack archives in Pre-Depends waves: dpkg will not unpack a package whose
# Pre-Depends are only unpacked, not configured. Normalize each wave before
# configuring so maintainer scripts run relocated ELFs. apt-get -f install is
# not used between waves because it would unpack the next wave without fixup.
unpack_in_waves() {
    run_as rm -f "$run_dir/remaining-debs.txt" \
        "$run_dir/remaining-debs.txt.next" "$run_dir/remaining-debs.txt.count"
    local prev=-1
    local wave=0
    local remaining
    while true; do
        binary="$root/bin/sh"
        arguments=("$run_dir/bxapt-unpack.sh" --unpack-wave)
        run_binary
        remaining="$(remaining_deb_count)"
        remaining="${remaining:-0}"
        fixup_unpacked_elf
        if [[ "${BIONICX_BXAPT_STOP_AFTER:-}" == unpack ]]; then
            return 0
        fi
        if [[ "$remaining" -eq 0 ]]; then
            configure_unpacked
            return 0
        fi
        configure_unpacked allow_fail
        if [[ "$remaining" -eq "$prev" ]]; then
            echo "bxapt: unpack wave made no progress (remaining=$remaining)" >&2
            exit 1
        fi
        prev=$remaining
        wave=$((wave + 1))
        if [[ "$wave" -ge 32 ]]; then
            echo "bxapt: exceeded unpack wave limit (remaining=$remaining)" >&2
            exit 1
        fi
    done
}

dpkg_arguments() {
    arguments=(--force-not-root --force-script-chrootless \
        --root="$root" --admindir="$root/var/lib/dpkg" "${arguments[@]}")
}

ensure_ldconfig_wrapper
mark_systemd_replacement

if [[ "$command_name" == fixup ]]; then
    fixup_elf
    exit
fi
if [[ "$command_name" == normalize ]]; then
    run_as test -d "$normalize_tree"
    fixup_elf "$normalize_tree"
    exit
fi

if [[ "$command_name" == recover ]]; then
    run_as test -s "$package_snapshot"
    run_as test -r "$requested_state"
    # A failed one-shot unpack never reached ELF normalization, so already
    # unpacked helpers still have the distro PT_INTERP. Fix the whole tree
    # before configuring; the last unpack manifest is not enough.
    fixup_elf
    # Configure already-unpacked Pre-Depends parents, then download whatever
    # the solver still needs and unpack those archives in waves.
    configure_unpacked allow_fail
    remove_standalone_systemd_if_replacing
    binary="$root/usr/bin/apt-get"
    arguments=(-f install -y --no-install-recommends --download-only)
    run_binary
    remove_standalone_systemd_if_replacing
    unpack_in_waves
    if [[ "${BIONICX_BXAPT_STOP_AFTER:-}" == unpack ]]; then
        exit 0
    fi
    binary="$root/usr/bin/apt-get"
    arguments=(-f install -y --no-install-recommends)
    run_binary
    requested_packages=()
    while IFS= read -r package || [[ -n "$package" ]]; do
        [[ -n "$package" ]] && requested_packages+=("$package")
    done < <(run_as cat "$requested_state")
    reconcile_package_state
    clear_transaction_state
    exit
fi

if [[ "$command_name" == deb ]]; then
    device_deb="$run_dir/incoming/${host_deb##*/}"
    upload_private "$host_deb" "$device_deb"
    trap 'run_as rm -f "$device_deb" >/dev/null 2>&1 || true' EXIT

    snapshot_package_state
    record_requested_packages
    binary="$root/bin/sh"
    arguments=("$run_dir/bxapt-unpack.sh" --unpack "$device_deb")
    run_binary
    fixup_unpacked_elf

    binary="$root/bin/sh"
    arguments=("$run_dir/bxapt-unpack.sh" --clear)
    run_binary
    binary="$root/usr/bin/apt-get"
    arguments=(-f install -y --no-install-recommends --download-only)
    run_binary
    remove_standalone_systemd_if_replacing
    unpack_in_waves
    binary="$root/usr/bin/apt-get"
    arguments=(-f install -y --no-install-recommends)
    run_binary
    reconcile_package_state
    exit
fi

binary="${binary:-$root/usr/bin/apt-get}"
if [[ "$command_name" == dpkg ]]; then
    binary="$root/usr/bin/dpkg"
    dpkg_arguments
elif [[ "$command_name" == query ]]; then
    binary="$root/usr/bin/dpkg-query"
    arguments=(--admindir="$root/var/lib/dpkg" "${arguments[@]}")
fi
if [[ "$command_name" == remove || "$command_name" == autoremove ]]; then
    requested_arguments=("${arguments[@]}")
    binary="$root/bin/sh"
    arguments=("$run_dir/bxapt-unpack.sh" --clear)
    run_binary
    binary="$root/usr/bin/apt-get"
    arguments=("${requested_arguments[@]}")
fi
if [[ "$command_name" == install || "$command_name" == set ]]; then
    requested_arguments=("${arguments[@]}")
    snapshot_package_state
    record_requested_packages
    binary="$root/bin/sh"
    arguments=("$run_dir/bxapt-unpack.sh" --clear)
    run_binary
    remove_standalone_systemd_if_replacing
    binary="$root/usr/bin/apt-get"
    arguments=("${requested_arguments[@]}" --download-only)
    run_binary
    remove_standalone_systemd_if_replacing
    unpack_in_waves
    if [[ "${BIONICX_BXAPT_STOP_AFTER:-}" == unpack ]]; then
        # Leave transaction metadata in place so a later recover can finish
        # unpacked or half-configured packages. This is a test hook, not a
        # product fallback mode.
        exit 0
    fi
    binary="$root/usr/bin/apt-get"
    arguments=(-f install -y --no-install-recommends)
fi
run_binary
case "$command_name" in
    install|set) reconcile_package_state; clear_transaction_state ;;
    remove|autoremove) fixup_unpacked_elf ;;
esac
