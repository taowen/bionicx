#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
package_id=io.taowen.bx
serial="${ANDROID_SERIAL:-}"
dns_servers="${BIONICX_DNS_SERVERS:-}"

usage() {
    echo "usage: tools/bxapt [--serial SERIAL] [--dns ADDRESSES] COMMAND [ARG ...]" >&2
    echo "commands: update, install, remove, set, deb, fixup, normalize, apt, dpkg, query, run" >&2
    exit "${1:-2}"
}

while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --serial) [[ $# -ge 2 ]] || usage; serial="$2"; shift 2 ;;
        --dns) [[ $# -ge 2 ]] || usage; dns_servers="$2"; shift 2 ;;
        --help) usage 0 ;;
        *) usage ;;
    esac
done
[[ $# -ge 1 ]] || usage
command_name="$1"
shift

adb_command=("${ADB:-adb}")
[[ -z "$serial" ]] || adb_command+=(-s "$serial")
root="/data/user/0/$package_id/files/rootfs"
files="/data/user/0/$package_id/files"
run_dir="$files/run/bxapt"
runtime_libs="$root/usr/lib:$root/usr/lib/aarch64-linux-gnu"
perl_libs="$root/etc/perl:$root/usr/share/perl5:$root/usr/lib/aarch64-linux-gnu/perl-base:$root/usr/lib/aarch64-linux-gnu/perl/5.40:$root/usr/share/perl/5.40"

run_as() {
    local command="run-as $(shell_quote "$package_id")"
    local argument
    for argument in "$@"; do
        command+=" $(shell_quote "$argument")"
    done
    "${adb_command[@]}" shell "$command"
}

shell_quote() {
    local value="${1//\'/\'\\\'\'}"
    printf "'%s'" "$value"
}

discover_dns() {
    [[ -n "$dns_servers" ]] && return
    dns_servers="$("${adb_command[@]}" shell dumpsys connectivity 2>/dev/null |
        sed -n 's/.*DnsAddresses: \[[^]]*\/\([0-9][0-9.]*\).*/\1/p' |
        head -n 1)"
}

upload_private() {
    local source="$1"
    local destination="$2"
    local temporary="/data/local/tmp/bxapt-$$-${source##*/}"
    "${adb_command[@]}" push "$source" "$temporary" >/dev/null
    run_as cp "$temporary" "$destination"
    "${adb_command[@]}" shell rm "$temporary"
}

prepare_state() {
    run_as test -x "$files/bin/bionicx-exec"
    run_as test -x "$root/usr/bin/apt-get"
    run_as test -r "$files/lib/libbionicx-runtime.so"
    run_as mkdir -p \
        "$run_dir/apt.conf.d" "$files/homes/bxapt" \
        "$run_dir/incoming" \
        "$root/var/lib/apt/lists/partial" \
        "$root/var/cache/apt/archives/partial" \
        "$root/var/log/apt"

    mkdir -p "$repo_dir/build"
    sed -e "s|@ROOT@|$root|g" -e "s|@FILES@|$files|g" \
        "$repo_dir/tools/bxapt.conf.in" > "$repo_dir/build/bxapt.conf"
    upload_private "$repo_dir/build/bxapt.conf" "$run_dir/apt.conf"
    upload_private "$repo_dir/tools/rootfs-elf-fixup.sh" \
        "$run_dir/rootfs-elf-fixup.sh"
    run_as cp "$root/etc/apt/sources.list.d/debian.sources" \
        "$run_dir/sources.sources"
}

case "$command_name" in
    update) arguments=(update) ;;
    install)
        [[ $# -ge 1 ]] || usage
        arguments=(install -y --no-install-recommends "$@")
        ;;
    remove)
        [[ $# -ge 1 ]] || usage
        arguments=(remove -y "$@")
        ;;
    set)
        [[ $# -eq 1 && -f "$1" ]] || usage
        packages=()
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%%#*}"
            read -r package extra <<< "$line"
            [[ -n "${package:-}" ]] || continue
            if [[ -n "${extra:-}" ||
                    ! "$package" =~ ^[a-z0-9][a-z0-9+.-]*(:arm64)?$ ]]; then
                echo "invalid package declaration: $line" >&2
                exit 2
            fi
            packages+=("$package")
        done < "$1"
        [[ ${#packages[@]} -gt 0 ]] || {
            echo "empty package set: $1" >&2
            exit 2
        }
        arguments=(install -y --no-install-recommends "${packages[@]}")
        ;;
    deb)
        [[ $# -eq 2 && -f "$1" && "$2" =~ ^[0-9a-fA-F]{64}$ ]] || usage
        host_deb="$(realpath "$1")"
        expected_sha256="${2,,}"
        actual_sha256="$(sha256sum "$host_deb" | cut -d' ' -f1)"
        if [[ "$actual_sha256" != "$expected_sha256" ]]; then
            echo "checksum mismatch for $host_deb" >&2
            echo "expected: $expected_sha256" >&2
            echo "actual:   $actual_sha256" >&2
            exit 1
        fi
        arguments=()
        ;;
    fixup) [[ $# -eq 0 ]] || usage; arguments=() ;;
    normalize)
        [[ $# -eq 1 && "$1" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || usage
        normalize_tree="$files/apps/$1"
        arguments=()
        ;;
    apt) arguments=("$@") ;;
    dpkg|query) arguments=("$@") ;;
    run)
        [[ $# -ge 1 ]] || usage
        if [[ "$1" == /* ]]; then
            binary="$root$1"
        else
            binary="$root/usr/bin/$1"
        fi
        shift
        arguments=("$@")
        ;;
    *) usage ;;
esac

discover_dns
prepare_state

environment=(
    "DPKG_DATADIR=$root/usr/share/dpkg"
    "DPKG_ROOT=$root"
    "LD_LIBRARY_PATH=$runtime_libs"
    "LD_PRELOAD=$files/lib/libbionicx-runtime.so"
    "BIONICX_ROOTFS=$root"
    "BIONICX_TMPDIR=$run_dir"
    "BIONICX_REWRITE_ABSOLUTE_SYMLINKS=1"
    "BIONICX_DNS_SERVERS=$dns_servers"
    "SEQUOIA_CRYPTO_POLICY=$root/usr/share/apt/default-sequoia.config"
    "PERL5LIB=$perl_libs"
    "DEBIAN_FRONTEND=noninteractive"
    "DEBCONF_NONINTERACTIVE_SEEN=true"
    "PATH=$root/usr/sbin:$root/usr/bin:$root/sbin:$root/bin:/system/bin"
    "HOME=$files/homes/bxapt"
    "TMPDIR=$run_dir"
)

run_binary() {
    local command_arguments=("${arguments[@]}")
    if [[ "$binary" == "$root/usr/bin/apt-get" ]]; then
        command_arguments=(-c "$run_dir/apt.conf" "${command_arguments[@]}")
    fi
    local launcher=(
        "$files/bin/bionicx-exec"
        --cwd "$root"
    )
    local assignment
    for assignment in "${environment[@]}"; do
        launcher+=(--env "$assignment")
    done
    launcher+=(-- "$binary" "${command_arguments[@]}")
    run_as "${launcher[@]}"
}

fixup_elf() {
    local tree="${1:-$root}"
    binary="$root/bin/sh"
    arguments=("$run_dir/rootfs-elf-fixup.sh" "$tree" "$root")
    run_binary
}

dpkg_arguments() {
    arguments=(--force-not-root --force-script-chrootless \
        --root="$root" --admindir="$root/var/lib/dpkg" "${arguments[@]}")
}

if [[ "$command_name" == fixup ]]; then
    fixup_elf
    exit
fi
if [[ "$command_name" == normalize ]]; then
    run_as test -d "$normalize_tree"
    fixup_elf "$normalize_tree"
    exit
fi

if [[ "$command_name" == deb ]]; then
    device_deb="$run_dir/incoming/${host_deb##*/}"
    upload_private "$host_deb" "$device_deb"
    trap 'run_as rm -f "$device_deb" >/dev/null 2>&1 || true' EXIT

    binary="$root/usr/bin/dpkg"
    arguments=(--unpack "$device_deb")
    dpkg_arguments
    run_binary

    binary="$root/usr/bin/apt-get"
    arguments=(-f install -y --no-install-recommends)
    run_binary
    fixup_elf
    exit
fi

binary="${binary:-$root/usr/bin/apt-get}"
if [[ "$command_name" == dpkg ]]; then
    binary="$root/usr/bin/dpkg"
    dpkg_arguments
elif [[ "$command_name" == query ]]; then
    binary="$root/usr/bin/dpkg-query"
    arguments=(--admindir="$root/var/lib/dpkg" "${arguments[@]}")
fi
run_binary
case "$command_name" in
    install|set) fixup_elf ;;
esac
