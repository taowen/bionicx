{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "keyboard-grab-x11-probe",
  "name": "BionicX cross-client X11 keyboard-grab probe",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${APP}/bin/keyboard-grab-x11-probe",
    "workingDirectory": "${APP}",
    "arguments": [
      "6"
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "en_US.UTF-8",
      "LOCPATH": "${RUNTIME}/usr/lib/locale"
    }
  }
}
