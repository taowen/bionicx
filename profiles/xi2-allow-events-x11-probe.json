{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "xi2-allow-events-x11-probe",
  "name": "BionicX XIAllowEvents probe",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${APP}/bin/xi2-allow-events-x11-probe",
    "workingDirectory": "${APP}",
    "arguments": [
      "3"
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "C.UTF-8"
    }
  }
}
