{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "feishu",
  "name": "Feishu ARM64",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "hostServices": [
    "dbus",
    "pulseaudio",
    "vulkan"
  ],
  "launch": {
    "executable": "${RUNTIME}/opt/bytedance/feishu/feishu",
    "workingDirectory": "${RUNTIME}/opt/bytedance/feishu",
    "argv0": "${RUNTIME}/opt/bytedance/feishu/feishu",
    "diagnoseSignals": false,
    "arguments": [
      "--no-sandbox",
      "--no-zygote",
      "--disable-seccomp-filter-sandbox",
      "--disable-breakpad",
      "--disable-crashpad-for-testing",
      "--disable-gpu-watchdog",
      "--disable-dev-shm-usage",
      "--disable-gpu-sandbox",
      "--ozone-platform=x11",
      "--use-gl=angle",
      "--use-angle=vulkan",
      "--disable-features=SkiaGraphite",
      "--enable-logging=stderr",
      "--user-data-dir=${HOME}/profile-feishu"
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "XDG_RUNTIME_DIR": "${TMP}/runtime",
      "XDG_DATA_DIRS": "${RUNTIME}/usr/local/share:${RUNTIME}/usr/share",
      "VK_ICD_FILENAMES": "${APP}/share/vulkan/icd.d/vortek_icd.json",
      "VORTEK_SERVER_PATH": "${RUNTIME}/tmp/.vortek/V0",
      "PULSE_SERVER": "unix:${RUNTIME}/tmp/.sound/PS0",
      "GSETTINGS_SCHEMA_DIR": "${RUNTIME}/usr/share/glib-2.0/schemas",
      "GSETTINGS_BACKEND": "memory",
      "GDK_PIXBUF_MODULE_FILE": "${RUNTIME}/usr/lib/aarch64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache",
      "NO_AT_BRIDGE": "1",
      "CHROME_EXTRA_FLAGS": "--disable-crashpad-for-testing --disable-gpu-watchdog",
      "BIONICX_CHILD_FLAGS": "--disable-crashpad-for-testing --disable-gpu-watchdog",
      "BIONICX_LOG_EXEC": "1",
      "GNOME_DISABLE_CRASH_DIALOG": "SET_BY_GOOGLE_CHROME",
      "SHELL": "/bin/sh",
      "PATH": "${RUNTIME}/usr/bin:${RUNTIME}/bin:/product/bin:/system/bin",
      "LANG": "C.UTF-8"
    }
  }
}
