{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 1,
  "id": "session-x11-probe",
  "name": "BionicX detached glibc X11 session probe",
  "display": {"dpi": 144, "socket": "filesystem"},
  "launch": {
    "mode": "loader",
    "loader": "${RUNTIME}/usr/lib/ld-linux-aarch64.so.1",
    "libraryPath": "${APP}/lib:${RUNTIME}/usr/lib",
    "executable": "${APP}/bin/session-x11-probe",
    "workingDirectory": "${APP}",
    "arguments": ["15"],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "C"
    }
  }
}
