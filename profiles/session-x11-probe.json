{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "session-x11-probe",
  "name": "BionicX detached glibc X11 session probe",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${APP}/bin/session-x11-probe",
    "workingDirectory": "${APP}",
    "arguments": [
      "15"
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "C"
    }
  }
}
