{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "xclock",
  "name": "XClock (Debian trixie ARM64)",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${RUNTIME}/usr/bin/xclock",
    "workingDirectory": "${HOME}",
    "arguments": [
      "-digital",
      "-update",
      "1",
      "-geometry",
      "1920x1080+0+0"
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "XDG_RUNTIME_DIR": "${TMP}/runtime",
      "FONTCONFIG_PATH": "${RUNTIME}/etc/fonts",
      "FONTCONFIG_FILE": "fonts.conf",
      "PATH": "${RUNTIME}/usr/bin:${RUNTIME}/bin:/product/bin:/system/bin",
      "LANG": "C.UTF-8"
    }
  }
}
