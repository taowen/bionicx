{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 1,
  "id": "save-set-x11-probe",
  "name": "BionicX cross-client X11 save-set probe",
  "display": {"dpi": 144, "socket": "filesystem"},
  "launch": {
    "mode": "loader",
    "loader": "${RUNTIME}/usr/lib/ld-linux-aarch64.so.1",
    "libraryPath": "${APP}/lib:${RUNTIME}/usr/lib",
    "executable": "${APP}/bin/save-set-x11-probe",
    "workingDirectory": "${APP}",
    "arguments": ["4"],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "C.UTF-8"
    }
  }
}
