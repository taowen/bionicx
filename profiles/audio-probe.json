{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "audio-probe",
  "name": "glibc X11 + Android audio probe",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "hostServices": [
    "pulseaudio"
  ],
  "launch": {
    "executable": "${APP}/bin/audio-probe",
    "workingDirectory": "${HOME}",
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "PULSE_SERVER": "unix:${RUNTIME}/tmp/.sound/PS0",
      "PATH": "${RUNTIME}/usr/bin:${RUNTIME}/bin:/product/bin:/system/bin",
      "LANG": "C.UTF-8"
    }
  }
}
