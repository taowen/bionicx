{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "wps-presentation",
  "name": "WPS Presentation (AArch64)",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${RUNTIME}/opt/kingsoft/wps-office/office6/wpp",
    "workingDirectory": "${RUNTIME}/opt/kingsoft/wps-office/office6",
    "argv0": "wpp",
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "XDG_RUNTIME_DIR": "${TMP}/runtime",
      "GCONV_PATH": "${RUNTIME}/usr/lib/aarch64-linux-gnu/gconv",
      "LANG": "C",
      "QT_QPA_PLATFORM": "xcb",
      "QT_X11_NO_MITSHM": "1",
      "PATH": "${RUNTIME}/usr/bin:${RUNTIME}/bin:/product/bin:/system/bin"
    }
  }
}
