{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 1,
  "id": "wps-office",
  "name": "WPS Presentation (AArch64)",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "compatibility": [
    "wps"
  ],
  "launch": {
    "mode": "direct",
    "executable": "${APP}/opt/kingsoft/wps-office/office6/wpp",
    "workingDirectory": "${APP}/opt/kingsoft/wps-office/office6",
    "argv0": "wpp",
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "XDG_RUNTIME_DIR": "${TMP}/runtime",
      "GCONV_PATH": "${RUNTIME}/usr/lib/gconv",
      "FONTCONFIG_PATH": "${APP}/etc/fonts",
      "FONTCONFIG_FILE": "fonts.conf",
      "LANG": "C",
      "QT_QPA_PLATFORM": "xcb",
      "QT_X11_NO_MITSHM": "1",
      "QT_OPENGL": "software",
      "LIBGL_ALWAYS_SOFTWARE": "1",
      "LD_LIBRARY_PATH": "${APP}/opt/kingsoft/wps-office/office6:${RUNTIME}/usr/lib",
      "LD_PRELOAD": "${RUNTIME}/usr/lib/libfreetype.so.6"
    }
  }
}
