{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "font-xft-probe",
  "name": "BionicX Fontconfig and Xft probe",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${APP}/bin/font-xft-probe",
    "workingDirectory": "${APP}",
    "arguments": [
      "${APP}/share/fonts",
      "8"
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "en_US.UTF-8",
      "LOCPATH": "${RUNTIME}/usr/lib/locale"
    }
  }
}
