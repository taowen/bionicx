{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "icewm-probe",
  "name": "BionicX IceWM managed desktop probe",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${APP}/bin/icewm-session",
    "workingDirectory": "${APP}",
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "en_US.UTF-8",
      "LOCPATH": "${RUNTIME}/usr/lib/locale",
      "BIONICX_APP": "${APP}",
      "BIONICX_RUNTIME": "${RUNTIME}",
      "ICEWM_PRIVCFG": "${APP}/share/icewm",
      "IMLIB2_LOADER_PATH": "${RUNTIME}/usr/lib/aarch64-linux-gnu/imlib2/loaders"
    }
  }
}
