{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "image-text8-shape-probe",
  "name": "ImageText8 and SHAPE probe",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${APP}/bin/image-text8-shape-probe",
    "workingDirectory": "${APP}",
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "C.UTF-8"
    }
  }
}
