{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "hello-x11",
  "name": "BionicX Xlib hello",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${APP}/bin/hello-x11",
    "workingDirectory": "${APP}",
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "C.UTF-8"
    }
  }
}
