{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 1,
  "id": "xterm",
  "name": "XTerm (Debian trixie ARM64)",
  "display": {"dpi": 144, "socket": "filesystem"},
  "launch": {
    "mode": "loader",
    "loader": "${RUNTIME}/usr/lib/ld-linux-aarch64.so.1",
    "libraryPath": "${RUNTIME}/usr/lib:${RUNTIME}/usr/lib/aarch64-linux-gnu",
    "executable": "${RUNTIME}/usr/bin/xterm",
    "workingDirectory": "${HOME}",
    "arguments": [
      "-ut",
      "-fa", "DejaVu Sans Mono",
      "-fs", "18",
      "-geometry", "120x34+0+0",
      "-title", "BionicX Debian Terminal",
      "-e", "${RUNTIME}/usr/bin/bash", "--noprofile", "--norc", "-i"
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "XDG_RUNTIME_DIR": "${TMP}/runtime",
      "SHELL": "${RUNTIME}/usr/bin/bash",
      "TERM": "xterm-256color",
      "FONTCONFIG_PATH": "${RUNTIME}/etc/fonts",
      "FONTCONFIG_FILE": "fonts.conf",
      "PATH": "${RUNTIME}/usr/bin:${RUNTIME}/bin:/product/bin:/system/bin",
      "LANG": "C.UTF-8"
    }
  }
}
