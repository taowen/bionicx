{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 1,
  "id": "dbus-probe",
  "name": "D-Bus session probe (Debian trixie ARM64)",
  "display": {"dpi": 144, "socket": "filesystem"},
  "hostServices": ["dbus"],
  "compatibility": ["android-seccomp", "android-tmp"],
  "launch": {
    "mode": "loader",
    "loader": "${RUNTIME}/usr/lib/ld-linux-aarch64.so.1",
    "libraryPath": "${RUNTIME}/usr/lib:${RUNTIME}/usr/lib/aarch64-linux-gnu",
    "executable": "${RUNTIME}/usr/bin/dbus-send",
    "workingDirectory": "${HOME}",
    "arguments": [
      "--session", "--print-reply", "--dest=org.freedesktop.DBus",
      "/org/freedesktop/DBus", "org.freedesktop.DBus.ListNames"
    ],
    "environment": {
      "HOME": "${HOME}", "TMPDIR": "${CACHE}",
      "BIONICX_ROOTFS": "${RUNTIME}",
      "PATH": "${RUNTIME}/usr/bin:${RUNTIME}/bin:/product/bin:/system/bin",
      "LANG": "C.UTF-8"
    }
  }
}
