{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "dbus-probe",
  "name": "D-Bus session probe (Debian trixie ARM64)",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "hostServices": [
    "dbus"
  ],
  "launch": {
    "executable": "${RUNTIME}/usr/bin/dbus-send",
    "workingDirectory": "${HOME}",
    "arguments": [
      "--session",
      "--print-reply",
      "--dest=org.freedesktop.DBus",
      "/org/freedesktop/DBus",
      "org.freedesktop.DBus.ListNames"
    ],
    "environment": {
      "HOME": "${HOME}",
      "TMPDIR": "${CACHE}",
      "PATH": "${RUNTIME}/usr/bin:${RUNTIME}/bin:/product/bin:/system/bin",
      "LANG": "C.UTF-8"
    }
  }
}
