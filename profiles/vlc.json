{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "vlc",
  "name": "VLC (Debian trixie ARM64)",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "hostServices": [
    "pulseaudio"
  ],
  "launch": {
    "executable": "${RUNTIME}/usr/bin/vlc",
    "workingDirectory": "${HOME}",
    "arguments": [
      "--loop",
      "--fullscreen",
      "--no-qt-privacy-ask",
      "--no-metadata-network-access",
      "--no-disable-screensaver",
      "--aout=pulse",
      "--vout=xcb_x11",
      "--no-video-title-show",
      "${APP}/fixtures/bionicx-motion-audio.avi"
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "XDG_RUNTIME_DIR": "${TMP}/runtime",
      "XDG_CONFIG_HOME": "${HOME}/.config",
      "XDG_CACHE_HOME": "${HOME}/.cache",
      "XDG_DATA_HOME": "${HOME}/.local/share",
      "XDG_DATA_DIRS": "${RUNTIME}/usr/local/share:${RUNTIME}/usr/share",
      "GSETTINGS_SCHEMA_DIR": "${RUNTIME}/usr/share/glib-2.0/schemas",
      "GSETTINGS_BACKEND": "memory",
      "GDK_PIXBUF_MODULE_FILE": "${RUNTIME}/usr/lib/aarch64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache",
      "VLC_PLUGIN_PATH": "${RUNTIME}/usr/lib/aarch64-linux-gnu/vlc/plugins",
      "PULSE_SERVER": "unix:${RUNTIME}/tmp/.sound/PS0",
      "QT_PLUGIN_PATH": "${RUNTIME}/usr/lib/aarch64-linux-gnu/qt5/plugins",
      "QT_QPA_PLATFORM": "xcb",
      "QT_XCB_GL_INTEGRATION": "none",
      "NO_AT_BRIDGE": "1",
      "PATH": "${RUNTIME}/usr/bin:${RUNTIME}/bin:/product/bin:/system/bin",
      "LANG": "C.UTF-8"
    }
  }
}
