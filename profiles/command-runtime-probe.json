{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 3,
  "id": "command-runtime-probe",
  "name": "BionicX command runtime probe",
  "display": {
    "dpi": 144,
    "socket": "filesystem"
  },
  "launch": {
    "executable": "${APP}/bin/runtime-probe",
    "workingDirectory": "${APP}",
    "arguments": [
      "--duration",
      "2"
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}",
      "HOME": "${HOME}",
      "TMPDIR": "${TMP}",
      "LANG": "en_US.UTF-8",
      "LOCPATH": "${RUNTIME}/usr/lib/locale",
      "BIONICX_TEST_ANDROID_SHELL": "1"
    }
  }
}
