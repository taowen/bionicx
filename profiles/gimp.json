{
  "$schema": "../schemas/profile.schema.json",
  "schemaVersion": 2,
  "id": "gimp",
  "name": "GIMP 3 (Debian trixie ARM64)",
  "display": {"dpi": 144, "socket": "filesystem"},
  "launch": {
    "mode": "loader",
    "loader": "${RUNTIME}/usr/lib/ld-linux-aarch64.so.1",
    "libraryPath": "${RUNTIME}/usr/lib:${RUNTIME}/usr/lib/aarch64-linux-gnu",
    "executable": "${RUNTIME}/usr/bin/bash",
    "workingDirectory": "${HOME}",
    "arguments": [
      "-c",
      "\"${RUNTIME}/usr/bin/icewm\" --sync & sleep 1; exec \"${RUNTIME}/usr/bin/gimp-3.0\" --no-splash --console-messages --gimprc \"${APP}/fixtures/gimprc\" \"${APP}/fixtures/bionicx-image.ppm\""
    ],
    "environment": {
      "DISPLAY": "${DISPLAY}", "HOME": "${HOME}", "TMPDIR": "${CACHE}",
      "XDG_RUNTIME_DIR": "${TMP}/runtime", "XDG_CONFIG_HOME": "${HOME}/.config",
      "XDG_CACHE_HOME": "${HOME}/.cache", "XDG_DATA_HOME": "${HOME}/.local/share",
      "XDG_DATA_DIRS": "${RUNTIME}/usr/local/share:${RUNTIME}/usr/share",
      "FONTCONFIG_PATH": "${RUNTIME}/etc/fonts", "FONTCONFIG_FILE": "fonts.conf",
      "GSETTINGS_SCHEMA_DIR": "${RUNTIME}/usr/share/glib-2.0/schemas",
      "GSETTINGS_BACKEND": "memory",
      "BABL_PATH": "${RUNTIME}/usr/lib/aarch64-linux-gnu/babl-0.1",
      "GEGL_PATH": "${RUNTIME}/usr/lib/aarch64-linux-gnu/gegl-0.4",
      "GIMP3_DATADIR": "${RUNTIME}/usr/share/gimp/3.0",
      "GIMP3_SYSCONFDIR": "${RUNTIME}/etc/gimp/3.0",
      "GIMP3_PLUGINDIR": "${RUNTIME}/usr/lib/aarch64-linux-gnu/gimp/3.0",
      "GI_TYPELIB_PATH": "${RUNTIME}/usr/lib/aarch64-linux-gnu/girepository-1.0",
      "ICEWM_PRIVCFG": "${RUNTIME}/usr/share/icewm",
      "IMLIB2_LOADER_PATH": "${RUNTIME}/usr/lib/aarch64-linux-gnu/imlib2/loaders",
      "GDK_PIXBUF_MODULE_FILE": "${RUNTIME}/usr/lib/aarch64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache",
      "DBUS_SESSION_BUS_ADDRESS": "disabled:", "NO_AT_BRIDGE": "1",
      "PATH": "${RUNTIME}/usr/bin:${RUNTIME}/bin:/product/bin:/system/bin", "LANG": "C.UTF-8"
    }
  }
}
